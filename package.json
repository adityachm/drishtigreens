{
  "name": "drishtigreens-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars false",
    "typecheck": "wrangler types --strict-vars false && tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply drishtigreens --local",
    "db:migrate:remote": "wrangler d1 migrations apply drishtigreens --remote",
    "seed:local": "node scripts/seed-media.ts --local",
    "seed:remote": "node scripts/seed-media.ts --remote",
    "set-password:local": "node scripts/set-password.ts --local",
    "set-password:remote": "node scripts/set-password.ts --remote"
  },
  "engines": {
    "node": ">=24"
  }
}
