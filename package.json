{
  "name": "drishtigreens-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "esbuild": "0.28.2",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "esbuild src/server.ts src/manage.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --log-level=warning",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run",
    "seed": "node scripts/seed-media.ts",
    "set-password": "npm run build && DATA_DIR=./data node dist/manage.js set-password"
  },
  "engines": {
    "node": ">=24"
  }
}
