{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drishtigreens",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-22",
  "observability": { "enabled": true },

  // Static files (CSS, JS, icons). Pages, media and the admin panel go through the Worker.
  "assets": { "directory": "public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drishtigreens",
      // From `npx wrangler d1 create drishtigreens` (see README, "One-time Cloudflare setup").
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "drishtigreens-media" }],

  // Gives each deployment an id, used to cache-bust /static/* URLs.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    // Cloudflare Turnstile site key (public). Leave empty to turn Turnstile off.
    // The matching secret is set with `npx wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SITE_KEY": ""
  }

  // Uncomment once drishtigreens.com is added to this Cloudflare account:
  // "routes": [
  //   { "pattern": "drishtigreens.com", "custom_domain": true },
  //   { "pattern": "www.drishtigreens.com", "custom_domain": true }
  // ]
}
